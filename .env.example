# Copy to .env (`cp .env.example .env`); Docker Compose reads it automatically.
# Placeholders only: never commit real values. `.env` is ignored by git.

# Postgres: compose creates the database with these and builds DATABASE_URL from them.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Ports published on the host (defaults 3000, 3333 and 5432). Only the web is reachable from the
# network; the api and Postgres are published on 127.0.0.1 for tools on this machine, because the
# browser reaches the api through the web and a public port would let anyone name the address the
# login lockout counts (AD-004).
WEB_PORT=3000
API_PORT=3333
POSTGRES_PORT=5432

# Compose project name: prefixes containers, volumes and the locally built images.
COMPOSE_PROJECT_NAME=application-manager

# Read by api and migrate (compose builds its own from POSTGRES_*; this one is for running them outside compose).
DATABASE_URL=postgres://app:change-me@localhost:5432/app

# Read by web (compose points it to the api service; this one is for running the web outside compose).
API_INTERNAL_URL=http://localhost:3333

# Read by api and web; the api builds the invitation link from it, and it is the origin the web accepts
# on a form post (CSRF). It must be the address the browser uses.
WEB_PUBLIC_URL=http://localhost:3000

# Read by web. Name of the header a reverse proxy in front of the web fills with the browser address
# (Cloudflare sends cf-connecting-ip); empty means the web uses the connection address, as in local dev.
# X-Forwarded-For from the browser is never read, whichever value this has.
CLIENT_IP_HEADER=

# Read by api (default true, which names the cookie `__Host-am_session` with Secure). Only local
# development sets false: the cookie cannot carry Secure over http, and the name is then `am_session`.
SESSION_COOKIE_SECURE=false

# Read by api, migrate and web (fatal, error, warn, info, debug or trace).
LOG_LEVEL=info

# PORT is read by api (default 3333) and web (default 3000); compose sets it per service.
# PORT=
