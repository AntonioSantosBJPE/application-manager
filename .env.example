# Copy to .env (`cp .env.example .env`); Docker Compose reads it automatically.
# Placeholders only: never commit real values. `.env` is ignored by git.

# Postgres: compose creates the database with these and builds DATABASE_URL from them.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Ports published on the host (defaults 3000, 3333 and 5432). Postgres is published on 127.0.0.1 only.
WEB_PORT=3000
API_PORT=3333
POSTGRES_PORT=5432

# Compose project name: prefixes containers, volumes and the locally built images.
COMPOSE_PROJECT_NAME=application-manager

# Read by api and migrate (compose builds its own from POSTGRES_*; this one is for running them outside compose).
DATABASE_URL=postgres://app:change-me@localhost:5432/app

# Read by web (compose points it to the api service; this one is for running the web outside compose).
API_INTERNAL_URL=http://localhost:3333

# Read by api, migrate and web (fatal, error, warn, info, debug or trace).
LOG_LEVEL=info

# PORT is read by api (default 3333) and web (default 3000); compose sets it per service.
# PORT=
