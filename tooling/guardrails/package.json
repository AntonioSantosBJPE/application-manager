{
  "name": "@am/guardrails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/root-commands.test.ts --exclude \"src/**/*.infra.test.ts\"",
    "test:repo-rules": "vitest run src/root-commands.test.ts",
    "test:deploy": "vitest run src/deploy --exclude \"src/**/*.infra.test.ts\"",
    "test:infra": "vitest run .infra.test.ts --passWithNoTests"
  },
  "devDependencies": {
    "@am/config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^10.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  }
}
